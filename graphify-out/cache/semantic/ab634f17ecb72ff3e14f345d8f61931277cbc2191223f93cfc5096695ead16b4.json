{"nodes": [{"id": "audit_report_wahoo_integration_audit", "label": "Wahoo Integration Audit Report", "file_type": "document", "source_file": "docs/wahoo/audit-report.md", "source_location": null, "source_url": "https://cloud-api.wahooligan.com/", "captured_at": "2026-06-22", "author": "Claude Code", "contributor": null}, {"id": "audit_report_td1_narrow_oauth_scopes", "label": "TD-1: Narrow OAuth Scopes", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity HIGH \u2014 current scope string is 'user_read workouts_read', which blocks power_zones_read, routes_read, plans_read, and offline_data (required for webhook delivery). Existing sessions will need re-auth after fix."}, {"id": "audit_report_td2_token_refresh", "label": "TD-2: Token Refresh Never Fires", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity HIGH \u2014 refresh_access_token() is defined but never called. On 401, _api_get() raises httpx.HTTPStatusError and the router returns 500. Fix: detect 401 in _api_get(), refresh token, update session, retry once."}, {"id": "audit_report_td3_workout_normalization", "label": "TD-3: Missing Workout Summary Fields in _normalize_activity()", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity MEDIUM \u2014 drops power_bike_np_last, power_bike_tss_last, cadence_avg, speed_avg, work_accum, power_avg, duration_active_accum, duration_paused_accum. Blocks analytics features."}, {"id": "audit_report_td4_pagination", "label": "TD-4: No Pagination on Workout Fetch", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity MEDIUM \u2014 Wahoo API defaults to 30 workouts per page; active users with >30 workouts in a date window see incomplete results. Fix: loop through pages until accumulated >= total or empty page."}, {"id": "audit_report_td5_webhook_log_only", "label": "TD-5: Webhooks Log-Only, No Data Refresh", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity MEDIUM \u2014 webhook_events.json stores events but no cache invalidation or data re-fetch is triggered. Fix: on workout_summary event, store summary keyed by user_id for next dashboard load."}, {"id": "audit_report_td6_settings_cache", "label": "TD-6: get_settings() Not Cached", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity LOW \u2014 .env is re-read on every request. Fix: decorate get_settings with @lru_cache(maxsize=1)."}, {"id": "audit_report_td7_structured_errors", "label": "TD-7: No Structured API Error Response to Frontend", "file_type": "concept", "source_file": "docs/wahoo/audit-report.md", "source_location": "Technical Debt \u2014 TD-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity LOW \u2014 raw httpx.HTTPStatusError propagates to FastAPI returning generic 500. Fix: catch in router layer and return structured JSON with status code and safe message."}, {"id": "audit_report_wahoo_client", "label": "WahooClient Service", "file_type": "code", "source_file": "docs/wahoo/audit-report.md", "source_location": "services/wahoo_client.py", "