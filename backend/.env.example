# Wahoo OAuth credentials — get from https://developers.wahooligan.com/
WAHOO_CLIENT_ID=your_client_id_here
WAHOO_CLIENT_SECRET=your_client_secret_here
WAHOO_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Flask-style secret for session cookie signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_this_to_a_random_secret_key

# Set to true to use built-in sample data (auto-detected when credentials are absent)
DEMO_MODE=true

# Frontend origin for CORS (must match your Vite dev server)
FRONTEND_URL=http://localhost:5173

# Webhook secret for verifying Wahoo push events (optional)
# Register your endpoint in the Wahoo developer portal as:
#   https://your-host/api/webhooks/wahoo
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WAHOO_WEBHOOK_SECRET=
