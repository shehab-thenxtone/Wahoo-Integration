# Wahoo OAuth credentials — get from https://developers.wahooligan.com
WAHOO_CLIENT_ID=your_client_id_here
WAHOO_CLIENT_SECRET=your_client_secret_here

# Redirect URI registered with Wahoo (must match exactly)
WAHOO_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Secret key for signing session cookies
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_a_real_secret

# App settings
# Set DEMO_MODE=true to run with sample data (no real Wahoo credentials needed)
DEMO_MODE=true
FRONTEND_URL=http://localhost:5173
